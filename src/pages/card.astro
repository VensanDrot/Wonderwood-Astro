---
import '../styles/global.css';
---
<html lang="en">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="description" content="Door of a Kind — Bespoke Interior Doors"/>
<title>Door of a Kind — Digital Card</title>
</head>
<body class="card-page">
<main class="card-shell">
<section class="business-card">
  <div class="card-rule"></div>
  <div class="card-logo"><span>D</span><i>K</i></div>
  <p class="eyebrow">DOOR OF A KIND</p>
  <h1>Bespoke<br/><em>Interior Doors</em></h1>
  <p class="card-line">Made for your space. Made to be yours.</p>
  <div class="card-actions">
    <a class="save" href="/door-of-a-kind.vcf" download>＋ &nbsp; SAVE CONTACT</a>
    <a href="mailto:hello@doorofakind.com">EMAIL</a>
    <a href="/">VIEW WEBSITE ↗</a>
    <a href="/#quote">START A PROJECT ↗</a>
  </div>
  <div class="qr-placeholder" aria-label="QR code placeholder"><span>QR</span><small>QR CODE WILL GO HERE</small></div>
  <p class="scan">Scan to open this card</p>
  <footer>NEW YORK · NEW JERSEY · LONG ISLAND</footer>
</section>
<a class="back" href="/">← Back to website</a>
</main>
<style>
:global(body){margin:0;background:#eee5d7;color:#17334a;font-family:Arial,sans-serif}.card-page{min-height:100vh}.card-shell{min-height:100vh;display:grid;place-items:center;padding:28px 16px}.business-card{position:relative;width:min(92vw,470px);box-sizing:border-box;background:#f7f1e8;border:1px solid rgba(184,132,63,.55);border-radius:28px;padding:42px 38px 32px;text-align:center;box-shadow:0 24px 70px rgba(23,51,74,.13);overflow:hidden}.card-rule{position:absolute;inset:13px;border:1px solid rgba(23,51,74,.13);border-radius:20px;pointer-events:none}.card-logo{position:relative;margin:0 auto 18px;width:72px;height:72px;border:1px solid rgba(184,132,63,.65);border-radius:50%;display:grid;place-items:center;font-family:Georgia,serif}.card-logo span{font-size:2.8rem;transform:translateX(-7px)}.card-logo i{position:absolute;font:normal 2.25rem Georgia,serif;color:#b8843f;transform:translate(11px,12px)}.eyebrow{font:600 13px Georgia,serif;letter-spacing:.28em;margin:0 0 25px}.business-card h1{font:400 44px/1 Georgia,serif;margin:0}.business-card h1 em{font-weight:400;color:#b8843f}.card-line{margin:24px auto 28px;max-width:310px;color:rgba(23,51,74,.68);line-height:1.5}.card-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}.card-actions a{border:1px solid rgba(23,51,74,.25);border-radius:13px;padding:15px 10px;color:#17334a;text-decoration:none;font-size:12px;font-weight:700;letter-spacing:.06em}.card-actions .save{grid-column:1/-1;background:#17334a;color:#f7f1e8;border-color:#17334a}.qr-placeholder{width:150px;height:150px;margin:28px auto 8px;background:#fffaf1;border-radius:18px;display:grid;place-items:center;border:1px solid rgba(184,132,63,.25)}.qr-placeholder span{font:700 38px Georgia,serif}.qr-placeholder small{font-size:8px;letter-spacing:.12em;color:#b8843f}.scan{font-size:11px;color:rgba(23,51,74,.5)}footer{margin-top:26px;font-size:9px;letter-spacing:.18em;color:#b8843f}.back{margin-top:18px;color:rgba(23,51,74,.6);font-size:12px;text-decoration:none}@media(max-width:420px){.business-card{padding:36px 24px 28px}.business-card h1{font-size:38px}}
</style>
</body></html>