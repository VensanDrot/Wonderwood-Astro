---
import '../styles/global.css';
import DoorCarousel from '../components/DoorCarousel.astro';
import { ArrowDown, ArrowUpRight, Ruler, Palette, Sparkles, Image as ImageIcon } from 'lucide-astro';
const R='https://pub-8a611935d9fb484d99efd9d57c7c4f66.r2.dev';
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Custom interior doors made for your space."/><title>Wonder Wood — Custom Interior Doors</title></head><body>
<header class="fixed top-0 inset-x-0 z-50 h-16 lg:h-20 flex items-center justify-between px-5 lg:px-12 bg-cream/80 backdrop-blur-xl border-b border-ink/5"><a href="#" class="leading-none"><span class="font-serif text-lg lg:text-xl">WONDER WOOD</span><small class="block text-[8px] tracking-[.2em] mt-1">CUSTOM INTERIOR DOORS</small></a><nav class="hidden md:flex gap-8 text-[11px] tracking-[.14em]"><a href="#designs">DESIGNS</a><a href="#space">YOUR SPACE</a><a href="#craft">CRAFT</a><a href="#quote">QUOTE</a></nav><a href="#quote" class="text-xs border-b border-gold pb-1">START A PROJECT</a></header>
<main><section class="relative min-h-[100svh] overflow-hidden"><picture><source media="(min-width:1000px)" srcset={R+'/hero/hero_desktop.png'}/><source media="(min-width:600px)" srcset={R+'/hero/hero_fold-tablet.png'}/><img src={R+'/hero/hero_mobile.png'} class="absolute inset-0 size-full object-cover" alt="Custom walnut interior door"/></picture><div class="hero-wash absolute inset-0"></div><div class="relative z-10 min-h-[100svh] flex flex-col justify-end lg:justify-center px-6 lg:px-[8vw] pb-20 lg:pb-0 max-w-4xl"><p class="text-[10px] tracking-[.28em] mb-5">MADE FOR YOUR SPACE</p><h1 class="hero-title font-serif text-[14vw] sm:text-7xl lg:text-[6.2rem] leading-[.86] tracking-[-.04em]"><span class="hero-let">LET</span><span class="hero-your-door">YOUR DOOR</span><span>PLAY</span><i>ITS ROLE.</i></h1><p class="max-w-sm mt-7 text-sm lg:text-base text-ink/65">Custom interiors start at the threshold.</p><a href="#designs" class="mt-8 inline-flex items-center gap-3 text-xs tracking-[.16em]">EXPLORE <ArrowDown size={15}/></a></div></section>
<section class="bg-ink text-cream py-9"><div class="flex justify-around flex-wrap gap-5 px-5 text-[10px] tracking-[.22em]"><span>SOLID WOOD</span><span>CUSTOM SIZES</span><span>ANY FINISH</span><span>ENGRAVING</span><span>TWO-SIDED DESIGN</span></div></section>
<section id="designs" class="px-5 lg:px-[7vw] py-24 lg:py-32 reveal"><p class="text-[10px] tracking-[.25em] text-gold mb-4">01 / DESIGN</p><div class="flex flex-col lg:flex-row lg:items-end justify-between gap-5"><h2 class="font-serif text-5xl lg:text-7xl leading-none">YOUR DESIGN.<br/>YOUR PALETTE.</h2><p class="max-w-xs text-sm text-ink/55">One collection. Endless combinations.</p></div><DoorCarousel/></section>
<section id="space" class="bg-sand px-5 lg:px-[7vw] py-20 lg:py-28 reveal">
  <div class="max-w-3xl">
    <h2 class="font-serif text-5xl lg:text-7xl leading-[.95]">ONE ROOM.<br/>DIFFERENT DOORS.</h2>
    <p class="mt-5 text-base lg:text-lg text-ink/60">See the change before you choose.</p>
    <p class="mt-3 max-w-2xl text-sm lg:text-base leading-relaxed text-ink/55">Send us a photo of your room, pick a door, and we’ll show you how it could look in your space.</p>
  </div>
  <div class="viz-desktop mt-10 lg:mt-14">
    <figure class="viz-before"><img src={R+'/visualize/room-before.png'} alt="Bedroom during renovation before the door is installed"/></figure>
    <div class="viz-sign" aria-hidden="true">+</div>
    <div class="viz-door-stack">
      <button class="viz-door active" data-viz="walnut" aria-label="Show walnut door"><img src={R+'/visualize/walnut-door.jpg'} alt="Walnut door"/></button>
      <button class="viz-door" data-viz="cream" aria-label="Show cream door"><img src={R+'/visualize/cream-door.png'} alt="Cream door"/></button>
      <button class="viz-door" data-viz="olive" aria-label="Show olive and gold door"><img src={R+'/doors/doors_olive-medallion.png'} alt="Olive and gold door"/></button>
    </div>
    <div class="viz-sign" aria-hidden="true">=</div>
    <div class="viz-results">
      <figure><img src={R+'/visualize/roopm-walnut.png'} alt="Bedroom with walnut door"/></figure>
      <figure><img src={R+'/visualize/room=-cream.png'} alt="Bedroom with cream door"/></figure>
      <figure><img src={R+'/visualize/room-olive-gold.png'} alt="Bedroom with olive and gold door"/></figure>
    </div>
  </div>
  <div class="viz-mobile mt-8">
    <figure class="overflow-hidden"><img src={R+'/visualize/room-before.png'} class="w-full" alt="Bedroom during renovation before the door is installed"/></figure>
    <div class="flex items-center justify-center gap-3 my-4">
      <span class="font-serif text-3xl">+</span>
      <button class="viz-mobile-door active" data-viz="walnut" aria-label="Walnut door"><img src={R+'/visualize/walnut-door.jpg'} alt="Walnut door"/></button>
      <button class="viz-mobile-door" data-viz="cream" aria-label="Cream door"><img src={R+'/visualize/cream-door.png'} alt="Cream door"/></button>
      <button class="viz-mobile-door" data-viz="olive" aria-label="Olive and gold door"><img src={R+'/doors/doors_olive-medallion.png'} alt="Olive and gold door"/></button>
      <span class="font-serif text-3xl">=</span>
    </div>
    <div class="viz-mobile-result">
      <img data-result="walnut" src={R+'/visualize/roopm-walnut.png'} alt="Bedroom with walnut door"/>
      <img data-result="cream" src={R+'/visualize/room=-cream.png'} alt="Bedroom with cream door" hidden/>
      <img data-result="olive" src={R+'/visualize/room-olive-gold.png'} alt="Bedroom with olive and gold door" hidden/>
    </div>
  </div>
  <a href="#quote" class="mt-8 inline-flex gap-2 items-center text-xs tracking-[.16em]">TRY YOUR SPACE <ArrowUpRight size={15}/></a>
</section>
<section id="craft" class="px-5 lg:px-[7vw] py-20 lg:py-28 reveal">
  <div class="max-w-3xl mb-10 lg:mb-14">
    <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl leading-[.95]">MADE AROUND<br/><i class="text-gold font-normal">YOUR IDEA.</i></h2>
    <p class="mt-5 max-w-4xl text-base sm:text-lg lg:text-xl leading-relaxed text-ink/65">Send us a sketch, a photo, or simply tell us what you have in mind. We can recreate it, adapt it, or help you find the right design for your space.</p>
    <p class="mt-4 max-w-4xl text-sm sm:text-base lg:text-lg leading-relaxed text-ink/55">From MDF to solid wood — walnut, ash, or pine. Materials, finishes, and details are chosen around your design, space, and budget.</p>
  </div>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-ink/10 border border-ink/10">
    <div class="bg-cream p-5 sm:p-7 lg:p-8 min-h-40 lg:min-h-48 flex flex-col justify-between"><Ruler size={22}/><div><h3 class="font-serif text-2xl lg:text-3xl">CUSTOM SIZE</h3><p class="mt-2 text-sm sm:text-base lg:text-lg leading-snug text-ink/60">Made to fit your opening.</p></div></div>
    <div class="bg-cream p-5 sm:p-7 lg:p-8 min-h-40 lg:min-h-48 flex flex-col justify-between"><Palette size={22}/><div><h3 class="font-serif text-2xl lg:text-3xl">ANY FINISH</h3><p class="mt-2 text-sm sm:text-base lg:text-lg leading-snug text-ink/60">Color, wood, texture — your choice.</p></div></div>
    <div class="bg-cream p-5 sm:p-7 lg:p-8 min-h-40 lg:min-h-48 flex flex-col justify-between"><ImageIcon size={22}/><div><h3 class="font-serif text-2xl lg:text-3xl">TWO SIDES.<br/>TWO LOOKS.</h3><p class="mt-2 text-sm sm:text-base lg:text-lg leading-snug text-ink/60">Different color, finish, or design on each side.</p></div></div>
    <div class="bg-cream p-5 sm:p-7 lg:p-8 min-h-40 lg:min-h-48 flex flex-col justify-between"><Sparkles size={22}/><div><h3 class="font-serif text-2xl lg:text-3xl">CUSTOM DETAILING</h3><p class="mt-2 text-sm sm:text-base lg:text-lg leading-snug text-ink/60">From clean and simple to fully ornate.</p></div></div>
  </div>
</section>

<section id="quote" class="bg-ink text-cream px-6 lg:px-[8vw] py-24 lg:py-32"><p class="text-[10px] tracking-[.25em] text-gold">NYC · NEW JERSEY · LONG ISLAND</p><div class="mt-5 flex flex-col lg:flex-row justify-between lg:items-end gap-10"><h2 class="font-serif text-6xl lg:text-8xl leading-none">LET'S MAKE<br/>YOUR DOOR.</h2><a href="mailto:hello@wonderwood.example" class="inline-flex items-center gap-3 border-b border-gold pb-2 text-sm tracking-[.15em]">REQUEST A QUOTE <ArrowUpRight size={18}/></a></div></section></main>
<script>const io=new IntersectionObserver(es=>es.forEach(e=>e.target.classList.toggle('on',e.isIntersecting)),{threshold:.12});document.querySelectorAll('.reveal').forEach(e=>io.observe(e));</script><style is:global>
.hero-wash{background:linear-gradient(90deg,rgba(247,241,232,.92) 0%,rgba(247,241,232,.72) 28%,rgba(247,241,232,.18) 54%,rgba(247,241,232,0) 72%)}
.hero-title span,.hero-title i{display:block}.hero-title i{color:#b8843f;font-style:italic;font-weight:400}
@media(max-width:480px){
  .hero-wash{background:linear-gradient(90deg,rgba(247,241,232,.92) 0%,rgba(247,241,232,.72) 30%,rgba(247,241,232,.14) 55%,rgba(247,241,232,0) 70%)}
  .hero>div.relative{justify-content:flex-start;padding-top:10.5vh;padding-bottom:3rem;padding-left:1.75rem;padding-right:1rem}
  .hero>div.relative>p:first-child{margin-bottom:.75rem;max-width:56vw}
  .hero-title{font-size:clamp(2.65rem,12.1vw,3.75rem);line-height:.82;max-width:58vw}
  .hero-title span,.hero-title i{white-space:nowrap}
  .hero-title + p{margin-top:1.05rem;max-width:55vw;font-size:.84rem;line-height:1.35}
  .hero-title ~ a{margin-top:1.15rem}
}
@media(min-width:481px) and (max-width:599px){
.hero-wash{background:linear-gradient(90deg,rgba(247,241,232,.94) 0%,rgba(247,241,232,.76) 31%,rgba(247,241,232,.20) 58%,rgba(247,241,232,0) 72%)}
.hero>div.relative{justify-content:flex-start;padding-top:13vh;padding-left:2rem;padding-right:1rem}
.hero>div.relative>p:first-child{margin-bottom:.9rem}
.hero-title{font-size:clamp(3rem,11.7vw,4rem);line-height:.84;max-width:60vw}
.hero-title span,.hero-title i{display:block;white-space:nowrap}
.hero-title + p{margin-top:1.15rem;max-width:56vw}
.hero-title ~ a{margin-top:1.25rem}
}
</style>
<style is:global>
.viz-desktop{display:none}
.viz-mobile-door,.viz-door{background:transparent;border:1px solid rgba(25,29,31,.14);transition:.25s ease}
.viz-mobile-door.active,.viz-door.active{border-color:#b8843f}
.viz-mobile-door{width:62px;height:82px;padding:3px}
.viz-mobile-door img,.viz-door img{width:100%;height:100%;object-fit:contain}
.viz-mobile-result{overflow:hidden}
.viz-mobile-result img{width:100%;height:auto;display:block}
@media(min-width:900px){
 .viz-mobile{display:none}.viz-desktop{display:grid;grid-template-columns:minmax(0,.76fr) 46px 170px 46px minmax(0,1.18fr);gap:8px;align-items:center}
 .viz-before img{width:100%;height:auto;display:block}.viz-sign{font-family:serif;font-size:52px;line-height:1;text-align:center;color:rgba(25,29,31,.62)}
 .viz-door-stack,.viz-results{display:grid;grid-template-rows:repeat(3,220px);gap:10px}
 .viz-door{height:220px;padding:4px}.viz-results figure{display:block;min-width:0;height:220px;overflow:hidden}
 .viz-results img{width:100%;height:100%;object-fit:contain;display:block}
}
@media(min-width:600px) and (max-width:899px){
 .viz-mobile{display:none}.viz-desktop{display:grid;grid-template-columns:minmax(0,.76fr) 30px 118px 30px minmax(0,1.08fr);gap:10px;align-items:center}
 .viz-before img{width:100%;height:auto;display:block}.viz-sign{font-family:serif;font-size:34px;text-align:center;color:rgba(25,29,31,.55)}
 .viz-door-stack,.viz-results{display:grid;grid-template-rows:repeat(3,150px);gap:12px}
 .viz-door{height:150px;padding:3px}.viz-results figure{display:block;min-width:0;height:150px;overflow:hidden}
 .viz-results img{width:100%;height:100%;object-fit:contain;display:block}
}
</style>
<script is:inline>
(()=>{
 const setViz=(key)=>{
   document.querySelectorAll('[data-viz]').forEach(b=>b.classList.toggle('active',b.dataset.viz===key));
   document.querySelectorAll('[data-result]').forEach(img=>img.hidden=img.dataset.result!==key);
 };
 document.querySelectorAll('[data-viz]').forEach(b=>b.addEventListener('click',()=>setViz(b.dataset.viz)));
})();
</script></body></html>