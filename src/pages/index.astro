---
import '../styles/global.css';
import DoorCarousel from '../components/DoorCarousel.astro';
import { ArrowDown, ArrowUpRight, Ruler, Palette, Sparkles, Image as ImageIcon } from 'lucide-astro';
const R='https://pub-8a611935d9fb484d99efd9d57c7c4f66.r2.dev';
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Door of a Kind creates bespoke interior doors for distinctive spaces across New York, New Jersey, and Long Island."/><meta property="og:title" content="Door of a Kind — Bespoke Interior Doors"/><meta property="og:description" content="Bespoke interior doors made for your space."/><title>Door of a Kind — Bespoke Interior Doors</title></head><body>
<header class="fixed top-0 inset-x-0 z-50 h-16 lg:h-20 flex items-center justify-between px-5 lg:px-12 bg-cream/80 backdrop-blur-xl border-b border-ink/5"><a href="#" class="brand-lockup leading-none" aria-label="Door of a Kind home"><span class="brand-mark" aria-hidden="true"><img src={R+'/Logo/door-of-a-kind-logo.png'} alt=""/></span><span class="brand-copy"><strong>DOOR OF A KIND</strong><small>BESPOKE INTERIOR DOORS</small></span></a><nav class="hidden md:flex gap-8 text-[11px] tracking-[.14em]"><a href="#designs">DESIGNS</a><a href="#space">YOUR SPACE</a><a href="#craft">CRAFT</a><a href="#quote">QUOTE</a></nav><a href="#quote" class="text-xs border-b border-gold pb-1">START A PROJECT</a></header>
<main><section class="relative min-h-[100svh] overflow-hidden"><picture><source media="(min-width:1000px)" srcset={R+'/hero/hero_desktop.png'}/><source media="(min-width:600px)" srcset={R+'/hero/hero_fold-tablet.png'}/><img src={R+'/hero/hero_mobile.png'} class="absolute inset-0 size-full object-cover" alt="Custom walnut interior door"/></picture><div class="hero-wash absolute inset-0"></div><div class="relative z-10 min-h-[100svh] flex flex-col justify-end lg:justify-center px-6 lg:px-[8vw] pb-20 lg:pb-0 max-w-4xl"><p class="text-[10px] tracking-[.28em] mb-5">MADE FOR YOUR SPACE</p><h1 class="hero-title font-serif text-[14vw] sm:text-7xl lg:text-[6.2rem] leading-[.86] tracking-[-.04em]"><span class="hero-let">LET</span><span class="hero-your-door">YOUR DOOR</span><span>PLAY</span><i>ITS ROLE.</i></h1><p class="max-w-sm mt-7 text-sm lg:text-base text-ink/65">Custom interiors start at the threshold.</p><a href="#designs" class="mt-8 inline-flex items-center gap-3 text-xs tracking-[.16em]">EXPLORE <ArrowDown size={15}/></a></div></section>
<section class="bg-ink text-cream py-9"><div class="flex justify-around flex-wrap gap-5 px-5 text-[10px] tracking-[.22em]"><span>SOLID WOOD</span><span>CUSTOM SIZES</span><span>ANY FINISH</span><span>ENGRAVING</span><span>TWO-SIDED DESIGN</span></div></section>
<section id="designs" class="px-5 lg:px-[7vw] py-24 lg:py-32 reveal"><div class="flex flex-col lg:flex-row lg:items-end justify-between gap-5"><h2 class="font-serif text-5xl lg:text-7xl leading-none">YOUR DESIGN.<br/>YOUR PALETTE.</h2><p class="max-w-xs text-sm text-ink/55">One collection. Endless combinations.</p></div><DoorCarousel/></section>
<section id="space" class="bg-sand px-5 lg:px-[7vw] py-20 lg:py-28 reveal">
  <div class="viz-heading max-w-3xl">
    <h2 class="font-serif text-5xl lg:text-7xl leading-[.95]">ONE ROOM.<br/>DIFFERENT DOORS.</h2>
    <p class="mt-5 text-base lg:text-lg text-ink/60">See the change before you choose.</p>
    <p class="mt-3 max-w-2xl text-sm lg:text-base leading-relaxed text-ink/55">Send us a photo of your room, pick a door, and we’ll show you how it could look in your space.</p>
  </div>
  <div class="viz-desktop mt-10 lg:mt-14">
    <div class="viz-before-wrap"><div class="viz-desktop-copy"><h2 class="font-serif">ONE ROOM.<br/>DIFFERENT DOORS.</h2></div><figure class="viz-before"><img src={R+'/visualize/room-before.jpg'} alt="Bedroom during renovation before the door is installed"/></figure><div class="viz-desktop-subcopy"><p>See the change before you choose.</p><small>Send us a photo of your room, pick a door, and we’ll show you how it could look in your space.</small></div></div>
    <div class="viz-sign" aria-hidden="true">+</div>
    <div class="viz-door-stack">
      <button class="viz-door active" data-viz="walnut" aria-label="Show walnut door"><img src={R+'/visualize/walnut-door.jpg'} alt="Walnut door"/></button>
      <button class="viz-door" data-viz="cream" aria-label="Show cream door"><img src={R+'/visualize/cream-door.png'} alt="Cream door"/></button>
      <button class="viz-door" data-viz="olive" aria-label="Show olive and gold door"><img src={R+'/doors/doors_olive-medallion.png'} alt="Olive and gold door"/></button>
    </div>
    <div class="viz-sign" aria-hidden="true">=</div>
    <div class="viz-results">
      <figure><img src={R+'/visualize/walnut-after.png'} alt="Bedroom with walnut door"/></figure>
      <figure><img src={R+'/visualize/cream-after.png'} alt="Bedroom with cream door"/></figure>
      <figure><img src={R+'/visualize/olive-after.png'} alt="Bedroom with olive and gold door"/></figure>
    </div>
  </div>
  <div class="viz-mobile mt-8">
    <figure class="overflow-hidden"><img src={R+'/visualize/room-before.jpg'} class="w-full" alt="Bedroom during renovation before the door is installed"/></figure>
    <div class="flex items-center justify-center gap-3 my-4">
      <span class="font-serif text-3xl">+</span>
      <button class="viz-mobile-door active" data-viz="walnut" aria-label="Walnut door"><img src={R+'/visualize/walnut-door.jpg'} alt="Walnut door"/></button>
      <button class="viz-mobile-door" data-viz="cream" aria-label="Cream door"><img src={R+'/visualize/cream-door.png'} alt="Cream door"/></button>
      <button class="viz-mobile-door" data-viz="olive" aria-label="Olive and gold door"><img src={R+'/doors/doors_olive-medallion.png'} alt="Olive and gold door"/></button>
      <span class="font-serif text-3xl">=</span>
    </div>
    <div class="viz-mobile-result">
      <img data-result="walnut" src={R+'/visualize/walnut-after.png'} alt="Bedroom with walnut door"/>
      <img data-result="cream" src={R+'/visualize/cream-after.png'} alt="Bedroom with cream door" hidden/>
      <img data-result="olive" src={R+'/visualize/olive-after.png'} alt="Bedroom with olive and gold door" hidden/>
    </div>
  </div>
  <a href="#quote" class="viz-try mt-8 inline-flex gap-2 items-center text-xs tracking-[.16em]">TRY YOUR SPACE <ArrowUpRight size={15}/></a>
</section>
<section id="craft" class="px-5 lg:px-[7vw] py-20 lg:py-28 reveal">
  <div class="max-w-3xl mb-10 lg:mb-14">
    <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl leading-[.95]">MADE AROUND<br/><i class="text-gold font-normal">YOUR IDEA.</i></h2>
    <p class="mt-5 max-w-4xl text-base sm:text-lg lg:text-xl leading-relaxed text-ink/65">Send us a sketch, a photo, or simply tell us what you have in mind. We can recreate it, adapt it, or help you find the right design for your space.</p>
    <p class="mt-4 max-w-4xl text-sm sm:text-base lg:text-lg leading-relaxed text-ink/55">From MDF to solid wood — walnut, ash, or pine. Materials, finishes, and details are chosen around your design, space, and budget.</p>
  </div>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-ink/10 border border-ink/10">
    <div class="bg-cream p-5 sm:p-7 lg:p-8 min-h-40 lg:min-h-48 flex flex-col justify-between"><Ruler size={22}/><div><h3 class="font-serif text-2xl lg:text-3xl">CUSTOM SIZE</h3><p class="mt-2 text-sm sm:text-base lg:text-lg leading-snug text-ink/60">Made to fit your opening.</p></div></div>
    <div class="bg-cream p-5 sm:p-7 lg:p-8 min-h-40 lg:min-h-48 flex flex-col justify-between"><Palette size={22}/><div><h3 class="font-serif text-2xl lg:text-3xl">ANY FINISH</h3><p class="mt-2 text-sm sm:text-base lg:text-lg leading-snug text-ink/60">Color, wood, texture — your choice.</p></div></div>
    <div class="bg-cream p-5 sm:p-7 lg:p-8 min-h-40 lg:min-h-48 flex flex-col justify-between"><ImageIcon size={22}/><div><h3 class="font-serif text-2xl lg:text-3xl">TWO SIDES.<br/>TWO LOOKS.</h3><p class="mt-2 text-sm sm:text-base lg:text-lg leading-snug text-ink/60">Different color, finish, or design on each side.</p></div></div>
    <div class="bg-cream p-5 sm:p-7 lg:p-8 min-h-40 lg:min-h-48 flex flex-col justify-between"><Sparkles size={22}/><div><h3 class="font-serif text-2xl lg:text-3xl">CUSTOM DETAILING</h3><p class="mt-2 text-sm sm:text-base lg:text-lg leading-snug text-ink/60">From clean and simple to fully ornate.</p></div></div>
  </div>
</section>

<section id="quote" class="bg-ink text-cream px-6 lg:px-[8vw] py-24 lg:py-32"><p class="text-[10px] tracking-[.25em] text-gold">NYC · NEW JERSEY · LONG ISLAND</p><div class="mt-5 flex flex-col lg:flex-row justify-between lg:items-end gap-10"><h2 class="font-serif text-6xl lg:text-8xl leading-none">LET'S MAKE<br/>YOUR DOOR.</h2><div class="flex flex-col items-start gap-4"><button type="button" data-open-project class="inline-flex items-center gap-3 border-b border-gold pb-2 text-sm tracking-[.15em] text-cream">REQUEST A QUOTE <ArrowUpRight size={18}/></button><a data-direct-contact href="mailto:hello@doorofakind.com" class="text-xs tracking-[.12em] text-cream/65">hello@doorofakind.com</a></div></div></section></main>

<div id="project-modal" class="project-modal" aria-hidden="true">
  <div class="project-backdrop" data-close-project></div>
  <div class="project-panel" role="dialog" aria-modal="true" aria-labelledby="project-title">
    <button type="button" class="project-close" data-close-project aria-label="Close">×</button>
    <p class="text-[10px] tracking-[.25em] text-gold">START A PROJECT</p>
    <h2 id="project-title" class="font-serif text-4xl lg:text-5xl leading-none mt-3">TELL US ABOUT<br/>YOUR DOOR.</h2>
    <form id="project-form" class="project-form mt-8" action="https://formsubmit.co/hello@doorofakind.com" method="POST">
      <input type="hidden" name="_subject" value="New Door of a Kind inquiry"/>
      <input type="hidden" name="_captcha" value="false"/>
      <input type="hidden" name="_template" value="table"/>
      <input type="hidden" name="lead_source" id="lead-source" value="Direct website"/>
      <input type="hidden" name="_next" value="https://doorofakind.com/thank-you"/>
      <label>Name<input required name="name" autocomplete="name"/></label>
      <label>Preferred contact<select required name="preferred_contact" id="preferred-contact"><option value="">Choose one</option><option value="email">Email</option><option value="phone">Phone / text</option></select></label>
      <label>Email<input type="email" id="contact-email" name="email" autocomplete="email"/></label>
      <label>Phone<input id="contact-phone" name="phone" autocomplete="tel"/></label>
      <button class="project-submit" type="submit">SEND REQUEST <span>↗</span></button>
      <p class="project-status" aria-live="polite">Leave the email or phone number you’d like us to use.</p>
    </form>
  </div>
</div>
<script>const io=new IntersectionObserver(es=>es.forEach(e=>e.target.classList.toggle('on',e.isIntersecting)),{threshold:.12});document.querySelectorAll('.reveal').forEach(e=>io.observe(e));</script><style is:global>
.brand-lockup{display:flex;align-items:center;gap:.65rem}.brand-mark{width:42px;height:42px;display:block;overflow:hidden}.brand-mark img{width:100%;height:100%;object-fit:contain;display:block}.brand-copy{display:block}.brand-copy strong{display:block;font-family:serif;font-weight:400;font-size:1rem;letter-spacing:.035em}.brand-copy small{display:block;font-size:7px;letter-spacing:.2em;margin-top:3px}@media(min-width:1024px){.brand-mark{width:48px;height:48px}.brand-copy strong{font-size:1.15rem}}
.hero-wash{background:linear-gradient(90deg,rgba(247,241,232,.92) 0%,rgba(247,241,232,.72) 28%,rgba(247,241,232,.18) 54%,rgba(247,241,232,0) 72%)}
.hero-title span,.hero-title i{display:block}.hero-title i{color:#b8843f;font-style:italic;font-weight:400}
@media(max-width:480px){
  .hero-wash{background:linear-gradient(90deg,rgba(247,241,232,.92) 0%,rgba(247,241,232,.72) 30%,rgba(247,241,232,.14) 55%,rgba(247,241,232,0) 70%)}
  .hero>div.relative{justify-content:flex-start;padding-top:10.5vh;padding-bottom:3rem;padding-left:1.75rem;padding-right:1rem}
  .hero>div.relative>p:first-child{margin-bottom:.75rem;max-width:56vw}
  .hero-title{font-size:clamp(2.65rem,12.1vw,3.75rem);line-height:.82;max-width:58vw}
  .hero-title span,.hero-title i{white-space:nowrap}
  .hero-title + p{margin-top:1.05rem;max-width:55vw;font-size:.84rem;line-height:1.35}
  .hero-title ~ a{margin-top:1.15rem}
}
@media(min-width:481px) and (max-width:599px){
.hero-wash{background:linear-gradient(90deg,rgba(247,241,232,.94) 0%,rgba(247,241,232,.76) 31%,rgba(247,241,232,.20) 58%,rgba(247,241,232,0) 72%)}
.hero>div.relative{justify-content:flex-start;padding-top:13vh;padding-left:2rem;padding-right:1rem}
.hero>div.relative>p:first-child{margin-bottom:.9rem}
.hero-title{font-size:clamp(3rem,11.7vw,4rem);line-height:.84;max-width:60vw}
.hero-title span,.hero-title i{display:block;white-space:nowrap}
.hero-title + p{margin-top:1.15rem;max-width:56vw}
.hero-title ~ a{margin-top:1.25rem}
}
</style>
<style is:global>
.viz-desktop{display:none}
.viz-desktop-copy,.viz-desktop-subcopy{display:none}.viz-mobile-door,.viz-door{background:transparent;border:1px solid rgba(25,29,31,.14);transition:.25s ease}
.viz-mobile-door.active,.viz-door.active{border-color:#b8843f}
.viz-mobile-door{width:62px;height:82px;padding:3px}
.viz-mobile-door img,.viz-door img{width:100%;height:100%;object-fit:contain}
.viz-mobile-result{overflow:hidden}
.viz-mobile-result img{width:100%;height:auto;display:block}
@media(min-width:900px){
 .viz-mobile{display:none}
 .viz-desktop{position:relative;display:grid;grid-template-columns:1fr 86px 190px 86px 1fr;column-gap:0;align-items:center;width:100%}
 .viz-heading{display:none}.viz-desktop-copy{display:block}
 .viz-before-wrap{justify-self:end;width:min(100%,420px);margin-right:28px;align-self:center;display:flex;flex-direction:column}
 .viz-before{width:100%}.viz-before img{width:100%;height:auto;display:block}
 .viz-desktop-copy{display:block;margin-bottom:20px}.viz-desktop-copy h2{font-size:clamp(2.25rem,3vw,3.6rem);line-height:.9;letter-spacing:-.03em}
 .viz-desktop-subcopy{display:block;margin-top:18px}.viz-desktop-subcopy p{font-size:1.45rem;line-height:1.25;color:rgba(25,29,31,.67)}.viz-desktop-subcopy small{display:block;margin-top:10px;font-size:1.05rem;line-height:1.45;color:rgba(25,29,31,.54)}
 #space .viz-try{margin-top:12px;transform:translateY(-18px)}
 .viz-sign{font-family:serif;font-size:76px;line-height:1;text-align:center;color:rgba(25,29,31,.72)}
 .viz-door-stack{display:grid;grid-template-rows:repeat(3,220px);gap:8px;width:190px;justify-self:center}
 .viz-door{height:220px;padding:4px}
 .viz-results{display:grid;grid-template-rows:repeat(3,238px);gap:6px;justify-self:start;width:min(100%,500px);margin-left:28px}
 .viz-results figure{display:block;min-width:0;height:238px;overflow:hidden}
 .viz-results img{width:100%;height:100%;object-fit:contain;object-position:left center;display:block}
}
@media(min-width:600px) and (max-width:899px){
 .viz-mobile{display:none}
 .viz-heading{display:none}
 .viz-desktop{display:grid;grid-template-columns:1fr 42px 126px 42px 1fr;column-gap:0;align-items:center;width:100%}
 .viz-before-wrap{justify-self:end;width:min(100%,280px);margin-right:14px;align-self:center;display:flex;flex-direction:column}
 .viz-desktop-copy{display:block;margin-bottom:16px}.viz-desktop-copy h2{font-size:clamp(2.45rem,5.8vw,3.65rem);line-height:.86;letter-spacing:-.035em}
 .viz-before{width:100%}.viz-before img{width:100%;height:auto;display:block}
 .viz-desktop-subcopy{display:block;margin-top:14px}.viz-desktop-subcopy p{font-size:1.3rem;line-height:1.25;color:rgba(25,29,31,.69)}.viz-desktop-subcopy small{display:block;margin-top:8px;font-size:1rem;line-height:1.42;color:rgba(25,29,31,.56)}
 .viz-sign{font-family:serif;font-size:46px;line-height:1;text-align:center;color:rgba(25,29,31,.68)}
 .viz-door-stack{display:grid;grid-template-rows:repeat(3,150px);gap:8px;width:126px;justify-self:center}
 .viz-door{height:150px;padding:3px}
 .viz-results{display:grid;grid-template-rows:repeat(3,158px);gap:6px;justify-self:start;width:min(100%,320px);margin-left:14px}
 .viz-results figure{display:block;min-width:0;height:158px;overflow:hidden}.viz-results img{width:100%;height:100%;object-fit:contain;object-position:left center;display:block}
 #space .viz-try{margin-top:8px;transform:translateY(-8px)}
}
</style>
<style is:global>
.project-modal{position:fixed;inset:0;z-index:100;display:none}.project-modal.open{display:block}.project-backdrop{position:absolute;inset:0;background:rgba(16,18,18,.62);backdrop-filter:blur(5px)}.project-panel{position:absolute;right:0;top:0;height:100%;width:min(100%,620px);overflow:auto;background:#f7f1e8;color:#191d1f;padding:clamp(2rem,5vw,4.5rem)}.project-close{position:absolute;right:1.5rem;top:1rem;font-size:2.2rem;font-weight:200}.project-form{display:grid;grid-template-columns:1fr 1fr;gap:1rem 1.25rem}.project-form label{font-size:.68rem;letter-spacing:.12em;text-transform:uppercase}.project-form label span{opacity:.5;text-transform:none;letter-spacing:0}.project-form input,.project-form select,.project-form textarea{display:block;width:100%;margin-top:.45rem;border:0;border-bottom:1px solid rgba(25,29,31,.25);background:transparent;padding:.7rem .15rem;font:inherit;font-size:.95rem;letter-spacing:0;text-transform:none;outline:none}.project-form textarea,.project-form label:nth-of-type(6),.project-form label:nth-of-type(7){grid-column:1/-1}.project-submit{grid-column:1/-1;margin-top:.5rem;background:#191d1f;color:#f7f1e8;padding:1rem 1.2rem;font-size:.72rem;letter-spacing:.16em}.project-status{grid-column:1/-1;font-size:.85rem}.contact-muted{opacity:.38}.contact-muted input{cursor:not-allowed}.partner-mode [data-direct-contact]{display:none}@media(max-width:599px){.project-form{grid-template-columns:1fr}.project-form label,.project-form textarea,.project-form label:nth-of-type(6),.project-form label:nth-of-type(7),.project-submit,.project-status{grid-column:1}}
</style>
<script is:inline>
(()=>{
 const partner=new URLSearchParams(location.search).get('source')==='partner'||location.pathname.startsWith('/partner'); if(partner)document.body.classList.add('partner-mode');
 const modal=document.querySelector('#project-modal'); const open=()=>{modal?.classList.add('open');modal?.setAttribute('aria-hidden','false');document.body.style.overflow='hidden'}; const close=()=>{modal?.classList.remove('open');modal?.setAttribute('aria-hidden','true');document.body.style.overflow=''}; document.querySelectorAll('[data-open-project]').forEach(b=>b.addEventListener('click',open)); document.querySelectorAll('[data-close-project]').forEach(b=>b.addEventListener('click',close)); document.addEventListener('keydown',e=>{if(e.key==='Escape')close()}); document.querySelectorAll('a[href="#quote"]').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();open()}));
 const ref=new URLSearchParams(location.search).get('ref'); const lead=document.querySelector('#lead-source'); if(lead)lead.value=ref?ref.charAt(0).toUpperCase()+ref.slice(1):(partner?'Partner / store website':'Direct website');
 const preferred=document.querySelector('#preferred-contact'),email=document.querySelector('#contact-email'),phone=document.querySelector('#contact-phone');
 const syncContact=()=>{const byEmail=preferred?.value==='email',byPhone=preferred?.value==='phone'; if(email){email.required=byEmail;email.disabled=byPhone;email.closest('label')?.classList.toggle('contact-muted',byPhone)} if(phone){phone.required=byPhone;phone.disabled=byEmail;phone.closest('label')?.classList.toggle('contact-muted',byEmail)}};
 preferred?.addEventListener('change',syncContact); syncContact();
 const setViz=(key)=>{
   document.querySelectorAll('[data-viz]').forEach(b=>b.classList.toggle('active',b.dataset.viz===key));
   document.querySelectorAll('[data-result]').forEach(img=>img.hidden=img.dataset.result!==key);
 };
 document.querySelectorAll('[data-viz]').forEach(b=>b.addEventListener('click',()=>setViz(b.dataset.viz)));
})();
</script></body></html>