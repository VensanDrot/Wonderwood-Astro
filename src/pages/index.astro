---
import '../styles/global.css';
import DoorCarousel from '../components/DoorCarousel.astro';
import { ArrowDown, ArrowUpRight, Ruler, Palette, Sparkles, Image as ImageIcon } from 'lucide-astro';
const R='https://pub-1f5a0b5c9e954dd29bbd15d75eecc956.r2.dev';
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Custom interior doors made for your space."/><title>Wonder Wood — Custom Interior Doors</title></head><body>
<header class="fixed top-0 inset-x-0 z-50 h-16 lg:h-20 flex items-center justify-between px-5 lg:px-12 bg-cream/80 backdrop-blur-xl border-b border-ink/5"><a href="#" class="leading-none"><span class="font-serif text-lg lg:text-xl">WONDER WOOD</span><small class="block text-[8px] tracking-[.2em] mt-1">CUSTOM INTERIOR DOORS</small></a><nav class="hidden md:flex gap-8 text-[11px] tracking-[.14em]"><a href="#designs">DESIGNS</a><a href="#space">YOUR SPACE</a><a href="#craft">CRAFT</a><a href="#quote">QUOTE</a></nav><a href="#quote" class="text-xs border-b border-gold pb-1">START A PROJECT</a></header>
<main><section class="relative min-h-[100svh] overflow-hidden"><picture><source media="(min-width:1000px)" srcset={R+'/hero/desktop.png'}/><source media="(min-width:600px)" srcset={R+'/hero/fold-tablet.png'}/><img src={R+'/hero/mobile.png'} class="absolute inset-0 size-full object-cover" alt="Custom walnut interior door"/></picture><div class="absolute inset-0 bg-gradient-to-t lg:bg-gradient-to-r from-cream via-cream/80 to-transparent"></div><div class="relative z-10 min-h-[100svh] flex flex-col justify-end lg:justify-center px-6 lg:px-[8vw] pb-20 lg:pb-0 max-w-4xl"><p class="text-[10px] tracking-[.28em] mb-5">MADE FOR YOUR SPACE</p><h1 class="font-serif text-[14vw] sm:text-7xl lg:text-[6.2rem] leading-[.86] tracking-[-.04em]">A DOOR<br/>WITH A<br/><i class="text-gold font-normal">ROLE.</i></h1><p class="max-w-sm mt-7 text-sm lg:text-base text-ink/65">Custom interiors start at the threshold.</p><a href="#designs" class="mt-8 inline-flex items-center gap-3 text-xs tracking-[.16em]">EXPLORE <ArrowDown size={15}/></a></div></section>
<section class="bg-ink text-cream py-9"><div class="flex justify-around flex-wrap gap-5 px-5 text-[10px] tracking-[.22em]"><span>SOLID WOOD</span><span>CUSTOM SIZES</span><span>ANY FINISH</span><span>ENGRAVING</span><span>TWO-SIDED DESIGN</span></div></section>
<section id="designs" class="px-5 lg:px-[7vw] py-24 lg:py-32 reveal"><p class="text-[10px] tracking-[.25em] text-gold mb-4">01 / DESIGN</p><div class="flex flex-col lg:flex-row lg:items-end justify-between gap-5"><h2 class="font-serif text-5xl lg:text-7xl leading-none">YOUR DESIGN.<br/>YOUR PALETTE.</h2><p class="max-w-xs text-sm text-ink/55">One collection. Endless combinations.</p></div><DoorCarousel/></section>
<section id="space" class="bg-sand px-5 lg:px-[7vw] py-24 lg:py-32 reveal"><div class="grid lg:grid-cols-2 gap-12 items-center"><div><p class="text-[10px] tracking-[.25em] text-gold mb-4">02 / VISUALIZE</p><h2 class="font-serif text-5xl lg:text-7xl">SEE IT<br/>BEFORE IT<br/>EXISTS.</h2><p class="mt-6 max-w-sm text-ink/55">Your room. A different door. No guessing.</p><a href="#quote" class="mt-8 inline-flex gap-2 items-center text-xs tracking-[.16em]">TRY YOUR SPACE <ArrowUpRight size={15}/></a></div><div class="relative"><img src={R+'/hero/fold-tablet.png'} class="w-full max-h-[72vh] object-contain" alt="Door visualization"/><div class="absolute bottom-4 left-4 bg-cream/80 backdrop-blur px-4 py-3 text-[10px] tracking-[.18em]">YOUR SPACE / OUR DOOR</div></div></div></section>
<section id="craft" class="px-5 lg:px-[7vw] py-24 lg:py-32 reveal"><div class="grid md:grid-cols-2 lg:grid-cols-4 gap-px bg-ink/10 border border-ink/10">{[[Ruler,'CUSTOM SIZE'],[Palette,'ANY FINISH'],[Sparkles,'DETAILING'],[ImageIcon,'YOUR IDEA']].map(([Icon,label])=><div class="bg-cream p-8 min-h-52 flex flex-col justify-between"><Icon size={24}/><h3 class="font-serif text-2xl">{label}</h3></div>)}</div></section>
<section class="relative min-h-[70vh] grid place-items-center overflow-hidden reveal"><img src={R+'/doors/navy-gold-ornate.png'} class="absolute inset-0 size-full object-contain opacity-20 scale-125" alt=""/><div class="relative z-10 text-center px-6"><p class="text-[10px] tracking-[.28em] mb-5">NOT OFF THE SHELF</p><h2 class="font-serif text-5xl lg:text-8xl">MADE FROM<br/><i class="text-gold font-normal">YOUR IDEA.</i></h2></div></section>
<section id="quote" class="bg-ink text-cream px-6 lg:px-[8vw] py-24 lg:py-32"><p class="text-[10px] tracking-[.25em] text-gold">NYC · NEW JERSEY · LONG ISLAND</p><div class="mt-5 flex flex-col lg:flex-row justify-between lg:items-end gap-10"><h2 class="font-serif text-6xl lg:text-8xl leading-none">LET'S MAKE<br/>YOUR DOOR.</h2><a href="mailto:hello@wonderwood.example" class="inline-flex items-center gap-3 border-b border-gold pb-2 text-sm tracking-[.15em]">REQUEST A QUOTE <ArrowUpRight size={18}/></a></div></section></main>
<script>const io=new IntersectionObserver(es=>es.forEach(e=>e.target.classList.toggle('on',e.isIntersecting)),{threshold:.12});document.querySelectorAll('.reveal').forEach(e=>io.observe(e));</script></body></html>