---
const base='https://pub-1f5a0b5c9e954dd29bbd15d75eecc956.r2.dev';
const doors=['navy-gold-ornate.png','natural-wood-workshop.png','white-clean-circle.png','olive-medallion.png','ivory-silver-ornate.png','navy-clean-circle.png','taupe-oval-fixed.png','olive-clean-circle.png','white-oval.jpg','taupe-gold-ornate.png'];
---
<div class="relative mt-10"><button class="prev hidden lg:grid absolute left-0 top-1/2 -translate-y-1/2 z-10 size-11 place-items-center rounded-full border border-gold/40 bg-cream/90 text-2xl">‹</button><div id="door-track" class="track flex gap-3 lg:gap-5 overflow-x-auto lg:px-14 snap-x snap-mandatory">{doors.map((d,i)=><figure class="shrink-0 w-[52%] sm:w-[38%] lg:w-[23%] snap-center group"><img src={base+'/doors/'+d} alt={'Custom door '+(i+1)} class="w-full aspect-[2/3] object-contain transition duration-700 group-hover:scale-[1.025]" loading={i<4?'eager':'lazy'}/></figure>)}</div><button class="next hidden lg:grid absolute right-0 top-1/2 -translate-y-1/2 z-10 size-11 place-items-center rounded-full border border-gold/40 bg-cream/90 text-2xl">›</button></div>
<script>const t=document.querySelector('#door-track');document.querySelector('.prev')?.addEventListener('click',()=>t?.scrollBy({left:-t.clientWidth*.72,behavior:'smooth'}));document.querySelector('.next')?.addEventListener('click',()=>t?.scrollBy({left:t.clientWidth*.72,behavior:'smooth'}));</script>